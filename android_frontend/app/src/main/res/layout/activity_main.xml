<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/turn_default"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_margin="16dp"
        android:background="@drawable/btn_secondary_background"
        android:contentDescription="@string/status_cd" />

    <LinearLayout
        android:id="@+id/boardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <!-- 3x3 grid using nested rows -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/cell0"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
                <Button
                    android:id="@+id/cell1"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
                <Button
                    android:id="@+id/cell2"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/cell3"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
                <Button
                    android:id="@+id/cell4"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
                <Button
                    android:id="@+id/cell5"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/cell6"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
                <Button
                    android:id="@+id/cell7"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
                <Button
                    android:id="@+id/cell8"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_margin="6dp"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/restartButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/restart"
        android:layout_margin="16dp"
        android:background="@drawable/btn_primary_background"
        android:contentDescription="@string/restart_cd" />

</LinearLayout>
