<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:elevation="6dp"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:gravity="center_vertical" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/turn_default"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:padding="@dimen/spacing_lg"
        android:layout_margin="@dimen/spacing_lg"
        android:background="@drawable/btn_secondary_background"
        android:contentDescription="@string/status_cd" />

    <!-- Responsive board container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/spacing_lg">

        <!-- Square board area constrained to width with 1:1 ratio -->
        <FrameLayout
            android:id="@+id/boardSquare"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:foregroundGravity="center"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- GridLayout for 3x3 cells; each cell uses 0dp to share space equally -->
            <GridLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:rowCount="3"
                android:useDefaultMargins="false"
                android:padding="@dimen/spacing_sm">

                <Button
                    android:id="@+id/cell0"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />

                <Button
                    android:id="@+id/cell1"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />

                <Button
                    android:id="@+id/cell2"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />

                <Button
                    android:id="@+id/cell3"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />

                <Button
                    android:id="@+id/cell4"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />

                <Button
                    android:id="@+id/cell5"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />

                <Button
                    android:id="@+id/cell6"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />

                <Button
                    android:id="@+id/cell7"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="2"
                    android:layout_column="1"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />

                <Button
                    android:id="@+id/cell8"
                    style="@style/Widget.TTT.CellButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text=""
                    android:layout_row="2"
                    android:layout_column="2"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_md" />
            </GridLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/restartButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/restart"
        android:layout_margin="@dimen/spacing_lg"
        android:background="@drawable/btn_primary_background"
        android:contentDescription="@string/restart_cd" />

</LinearLayout>
